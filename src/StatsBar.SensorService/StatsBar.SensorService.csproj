<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WinStats.SensorService</AssemblyName>
    <RootNamespace>WinStats.SensorService</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\CpuTemperatureProtocol.cs" Link="CpuTemperatureProtocol.cs" />
    <Compile Include="..\Shared\PawnIoInstaller.cs" Link="PawnIoInstaller.cs" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <None Update="notices\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
