<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>StatsBar</RootNamespace>
    <AssemblyName>WinStats</AssemblyName>
    <Product>Win Stats</Product>
    <AssemblyTitle>Win Stats</AssemblyTitle>
    <Company>Win Stats</Company>
    <Description>System stats for the Windows taskbar.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinStats.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\WinStats.ico" />
  </ItemGroup>

</Project>
